{
  "root": true,
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "plugins": [
    "prettier"
  ],
  "rules": {
    "prettier/prettier": "error",
    "no-undef": "error"
  },
  "env": {
    "es6": true,
    "node": true,
    "mocha": true
  },
  "overrides": [
    {
      "files": [
        "lib/**/*.js"
      ],
      "parserOptions": {
        "ecmaVersion": 2020
      }
    }
  ]
}
